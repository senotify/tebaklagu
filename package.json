{
  "name": "tebaklagu",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "api": "DB_PATH=./scores.db node --disable-warning=ExperimentalWarning server/index.mjs",
    "catalog:resolve": "node scripts/resolve-artists.mjs",
    "catalog:verify": "node scripts/verify-artists.mjs",
    "catalog:audit": "node scripts/audit-artists.mjs",
    "catalog:build": "node scripts/build-playlists.mjs && node scripts/check-catalog.mjs",
    "catalog:check": "node scripts/check-catalog.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
